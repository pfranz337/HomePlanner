<base:BaseControlView x:Class="HPAdmin.UI.Controls.MVVM.Views.TasksControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:bindingProxy="clr-namespace:HPAdmin.UI.BindingProxy"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:models="clr-namespace:HPAdmin.UI.Models"
             xmlns:viewModels="clr-namespace:HPAdmin.UI.Controls.MVVM.ViewModels"
             xmlns:base="clr-namespace:HPAdmin.UI.Views.Base"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:TasksControlViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <base:BaseControlView.Resources>
        <bindingProxy:TasksControlBindingProxy x:Key="Proxy" Data="{Binding}" />

        <Style x:Key="TaskTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>

    </base:BaseControlView.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Content="Nový" Command="{Binding AddTaskCommand}"
                HorizontalAlignment="Stretch" />
        <Button Grid.Row="0" Grid.Column="2" Content="Uložit" Command="{Binding SaveDataCommand}"
                HorizontalAlignment="Stretch" />

        <ListBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" ItemsSource="{Binding HomeTasks}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:HomeTaskModel}">
                    <Border BorderBrush="Black" BorderThickness="1" Padding="4" Background="AntiqueWhite">
                        <Grid HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="4" />
                                <RowDefinition />
                                <RowDefinition Height="4" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Label Content="Název:" Grid.Row="0" Grid.Column="0" />
                            <TextBox Text="{Binding Title}" Style="{StaticResource TaskTextBoxStyle}"
                                     Grid.Column="1" Grid.Row="0" TextWrapping="NoWrap" AcceptsReturn="False"
                                     MaxLength="150" />

                            <Label Content="Popis:" Grid.Row="2" Grid.Column="0" />
                            <TextBox Text="{Binding Description}" Style="{StaticResource TaskTextBoxStyle}"
                                     Grid.Column="1" Grid.Row="2" TextWrapping="WrapWithOverflow" AcceptsReturn="True"
                                     MaxLength="300" MaxLines="30" />

                            <Button Content="X" ToolTip="Smazat" Width="32" HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding Source={StaticResource Proxy}, Path=Data.DeleteTaskCommand}"
                                    CommandParameter="{Binding}"
                                    Grid.Column="3" Grid.Row="0" Grid.RowSpan="3" />

                            <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Left"
                                      Content="Hotovo" IsChecked="{Binding IsCompleted}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</base:BaseControlView>
