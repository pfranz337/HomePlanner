<Window x:Class="HPAdmin.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:models="clr-namespace:HPAdmin.UI.Models"
        xmlns:ui="clr-namespace:HPAdmin.UI"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="350" Width="525">

    <Window.Resources>
        <ui:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Window.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <prism:InvokeCommandAction Command="{Binding ViewLoaded}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Button Content="Add" Command="{Binding AddTask}" />
            <Button Content="Save" Command="{Binding Save}" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding HomeTasks}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:HomeTaskModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Dto.Title}" Grid.Column="0" />
                        <Button Content="X" 
                                Command="{Binding Source={StaticResource Proxy}, Path=Data.DeleteTask}" 
                                CommandParameter="{Binding}" 
                                Grid.Column="1" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>